# Managed project workspace — independent client/personal repos, never tracked here
projects/

# Local scratch (customer skill imports, exported conversations, etc.)
tmp/

# Local-only Claude Code settings
.claude/settings.local.json

# fvermaut's own scratch list at the root — deliberately not a process artifact,
# and left untouched by agents. Ignored so it stops reading as untracked residue.
doc/todo.md

# Daemon machine state — runs, queue positions, cursors. One machine, one
# daemon (ADR-0003): this is local state, never a process artifact.
.timone/

# The daemon's own output, when it is redirected. The README tells the reader
# to run `node dist/cli.js daemon > daemon.log`, and an untracked file at the
# root is a file outside the target project — which the path-containment
# guardrail then reports, correctly and uselessly, on whatever run was in
# flight. Seen live on 2026-08-07.
daemon.log

# Node
node_modules/
dist/

# Playwright MCP session residue — the server writes console logs and traces into
# the session cwd, which is the timone root. Untracked residue here would trip the
# execute skill's dirty-tree rule on the next run.
.playwright-mcp/

# OS
.DS_Store
